{
  "rewrites": [
    {
      "source": "/((?!assets/|favicon.ico|logo.png|ceo-zaheerudin.jpg|ceo-hamza.jpg|sitemap.xml|googleb4c58d72268adab2.html).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*\\.html)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
